# Copy this file to `.env.local` and fill in your real key.
# `.env.local` is gitignored — your key is NEVER committed.

# Anthropic API key — get it from https://console.anthropic.com (API Keys).
# Used ONLY on the server to extract data from contract note PDFs.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the model used for extraction.
# ANTHROPIC_MODEL=claude-sonnet-5

# ---- Supabase (added in a later step) ----
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
