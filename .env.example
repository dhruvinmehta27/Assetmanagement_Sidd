# Copy this file to `.env.local` and fill in your real key.
# `.env.local` is gitignored — your key is NEVER committed.

# Anthropic API key — get it from https://console.anthropic.com (API Keys).
# Used ONLY on the server to extract data from contract note PDFs.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the model used for extraction.
# ANTHROPIC_MODEL=claude-sonnet-5

# ---- Supabase ----
# Project URL, e.g. https://xxxxxxxx.supabase.co  (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
# Service role key (Settings -> API -> Project API keys -> service_role).
# SERVER-SIDE ONLY. Bypasses RLS. Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=
